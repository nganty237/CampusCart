<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusCart.Controls"
             xmlns:icons="clr-namespace:IconFont.Maui.MaterialDesignIcons;assembly=IconFont.Maui.MaterialDesignIcons"
             xmlns:vm="clr-namespace:CampusCart.ViewModels"
             x:Class="CampusCart.Pages.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F7F8FA">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,14,20,10" ColumnDefinitions="34,*" ColumnSpacing="8">
            <Button Text="{x:Static icons:MaterialDesignIconsOutlinedRegular.ArrowBack}"
                    FontFamily="MaterialDesignIconsOutlined" FontSize="23"
                    Command="{Binding OpenSignInCommand}"
                    SemanticProperties.Description="Retour à la connexion"
                    BackgroundColor="Transparent" TextColor="#17223A"
                    Padding="0" HeightRequest="40" WidthRequest="34" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Mot de passe oublié ?" FontSize="21" FontAttributes="Bold" TextColor="#151820" />
                <Label Text="Récupère l'accès à ton compte étudiant." FontSize="11" TextColor="#858B98" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" HorizontalOptions="Fill" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="480" HorizontalOptions="Center"
                                 Padding="24,22,24,30" Spacing="18">
                <Border BackgroundColor="#E3EAFE" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="20">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border HeightRequest="64" WidthRequest="64" BackgroundColor="#D4DEFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 32">
                            <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.LockReset}"
                                              IconSize="31" IconColor="#315CEB" />
                        </Border>
                        <Label Text="On va t'aider à retrouver ton compte."
                               FontSize="13" FontAttributes="Bold" TextColor="#315CEB"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Saisis ton adresse universitaire et tu verras les prochaines étapes."
                               FontSize="11" TextColor="#53679B" LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-mail universitaire" FontSize="12" TextColor="#292D36" />
                        <Entry Text="{Binding Email}" Placeholder="prenom.nom@enspd.cm"
                               Keyboard="Email" ReturnType="Done"
                               BackgroundColor="White" TextColor="#242833" PlaceholderColor="#9AA0AB"
                               HeightRequest="50" ClearButtonVisibility="WhileEditing" />
                        <Label Text="{Binding EmailError}" FontSize="10" TextColor="#E5484D"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Continuer" Command="{Binding SubmitCommand}"
                            BackgroundColor="#315CEB" TextColor="White" FontSize="13"
                            FontAttributes="Bold" CornerRadius="11" HeightRequest="50" />
                    <Label Text="Pour le moment, cette étape simule l'envoi du lien côté frontend."
                           FontSize="10" TextColor="#858B98" LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
