<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusCart.Controls"
             xmlns:icons="clr-namespace:IconFont.Maui.MaterialDesignIcons;assembly=IconFont.Maui.MaterialDesignIcons"
             xmlns:vm="clr-namespace:CampusCart.ViewModels"
             x:Class="CampusCart.Pages.LandingPage"
             x:DataType="vm:LandingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F7F8FC">
    <ScrollView MaximumWidthRequest="480" HorizontalOptions="Center"
                VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24,28,24,26" Spacing="22" VerticalOptions="Center">

            <!-- Identité de la marque -->
            <Grid ColumnDefinitions="46,*" ColumnSpacing="11" VerticalOptions="Center">
                <Border HeightRequest="46" WidthRequest="46" BackgroundColor="#315CEB"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.School}"
                                      IconSize="25" IconColor="White" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="CampusCart" FontSize="18" FontAttributes="Bold" TextColor="#17223A" />
                    <Label Text="Les services de ton campus" FontSize="11" TextColor="#7A8599" />
                </VerticalStackLayout>
            </Grid>

            <!-- Présentation principale -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 24" Padding="20,21" HeightRequest="244">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#315CEB" Offset="0.0" />
                        <GradientStop Color="#2449C7" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Start"
                            BackgroundColor="#29FFFFFF" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" Padding="10,5">
                        <Label Text="LE CAMPUS, CÔTÉ ENTRAIDE" FontSize="9" FontAttributes="Bold"
                               CharacterSpacing="0.6" TextColor="White" />
                    </Border>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="9" VerticalOptions="End">
                        <Label Text="Tout ce qu’il te faut,&#10;à deux pas." FontSize="25" LineHeight="1.05"
                               FontAttributes="Bold" TextColor="White" />
                        <Label Text="Cours, impression, dépannage… découvre les services proposés par les étudiants de ton campus."
                               FontSize="12" LineHeight="1.3" TextColor="#E7EDFF" />
                    </VerticalStackLayout>
                    <Border Grid.Row="1" Grid.Column="1" HeightRequest="60" WidthRequest="60"
                            BackgroundColor="#29FFFFFF" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" VerticalOptions="End" HorizontalOptions="End">
                        <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.Handshake}"
                                          IconSize="34" IconColor="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Deux usages clés -->
            <VerticalStackLayout Spacing="10">
                <Border BackgroundColor="White" Stroke="#E8ECF3" StrokeThickness="1"
                        StrokeShape="RoundRectangle 15" Padding="13">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#EEF3FF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.Search}"
                                              IconSize="21" IconColor="#315CEB" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Trouve le bon coup de main" FontSize="12" FontAttributes="Bold" TextColor="#202B43" />
                            <Label Text="Des services utiles, proposés près de toi." FontSize="10" TextColor="#7A8599" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border BackgroundColor="White" Stroke="#E8ECF3" StrokeThickness="1"
                        StrokeShape="RoundRectangle 15" Padding="13">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                        <Border HeightRequest="42" WidthRequest="42" BackgroundColor="#F1F3FF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.Handshake}"
                                              IconSize="21" IconColor="#5969D9" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Partage tes talents" FontSize="12" FontAttributes="Bold" TextColor="#202B43" />
                            <Label Text="Propose ton service à la communauté étudiante." FontSize="10" TextColor="#7A8599" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Entrée dans l'application -->
            <VerticalStackLayout Spacing="9">
                <Button Text="Se connecter" Command="{Binding OpenSignInCommand}"
                        BackgroundColor="#315CEB" TextColor="White" FontSize="14"
                        FontAttributes="Bold" CornerRadius="13" HeightRequest="52" />
                <Button Text="Créer un compte" Command="{Binding OpenRegistrationCommand}"
                        BackgroundColor="White" TextColor="#26324B" FontSize="13"
                        FontAttributes="Bold" CornerRadius="13" HeightRequest="50"
                        BorderColor="#E1E6EF" BorderWidth="1" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.PeopleOutline}"
                                  IconSize="15" IconColor="#8B95A8" WidthRequest="17" HeightRequest="17" />
                <Label Text="Une communauté réservée aux étudiants" FontSize="10" TextColor="#8B95A8"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
