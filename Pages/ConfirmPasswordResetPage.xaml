<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusCart.Controls"
             xmlns:icons="clr-namespace:IconFont.Maui.MaterialDesignIcons;assembly=IconFont.Maui.MaterialDesignIcons"
             xmlns:vm="clr-namespace:CampusCart.ViewModels"
             x:Class="CampusCart.Pages.ConfirmPasswordResetPage"
             x:DataType="vm:ConfirmPasswordResetViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F7F8FA">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,14,20,10" ColumnDefinitions="34,*" ColumnSpacing="8">
            <Button Text="{x:Static icons:MaterialDesignIconsOutlinedRegular.ArrowBack}"
                    FontFamily="MaterialDesignIconsOutlined" FontSize="23"
                    Command="{Binding BackCommand}"
                    SemanticProperties.Description="Retour à la demande de réinitialisation"
                    BackgroundColor="Transparent" TextColor="#17223A"
                    Padding="0" HeightRequest="40" WidthRequest="34" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Code de confirmation" FontSize="21" FontAttributes="Bold" TextColor="#151820" />
                <Label Text="Vérifie que la demande vient bien de toi." FontSize="11" TextColor="#858B98" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" HorizontalOptions="Fill" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout MaximumWidthRequest="480" HorizontalOptions="Center"
                                 Padding="24,22,24,30" Spacing="18">
                <Border BackgroundColor="#E3EAFE" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="20">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border HeightRequest="64" WidthRequest="64" BackgroundColor="#D4DEFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 32">
                            <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.MarkEmailRead}"
                                              IconSize="31" IconColor="#315CEB" />
                        </Border>
                        <Label Text="Un code a été envoyé" FontSize="14" FontAttributes="Bold"
                               TextColor="#315CEB" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Email}" FontSize="11" TextColor="#53679B"
                               LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsFormVisible}" Spacing="7">
                    <Label Text="Code de confirmation" FontSize="12" TextColor="#292D36" />
                    <Entry Text="{Binding Code}" Placeholder="Saisis les 6 chiffres"
                           Keyboard="Numeric" MaxLength="6" ReturnType="Done"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="White" TextColor="#242833" PlaceholderColor="#9AA0AB"
                           FontSize="20" HeightRequest="56" />
                    <Label Text="{Binding DemoCodeHint}" FontSize="10" TextColor="#315CEB"
                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CodeError}" FontSize="10" TextColor="#E5484D"
                           LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button IsVisible="{Binding IsFormVisible}" Text="Vérifier le code" Command="{Binding ConfirmCommand}"
                        BackgroundColor="#315CEB" TextColor="White" FontSize="13"
                        FontAttributes="Bold" CornerRadius="11" HeightRequest="50" />
                <Label IsVisible="{Binding IsFormVisible}" Text="La vérification est simulée localement pour cette version frontend."
                       FontSize="10" TextColor="#858B98" LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout IsVisible="{Binding IsConfirmed}" Spacing="12"
                                     HorizontalOptions="Center">
                    <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.CheckCircleOutline}"
                                      IconSize="42" IconColor="#2DA875" />
                    <Label Text="Code validé" FontSize="17" FontAttributes="Bold"
                           TextColor="#17223A" HorizontalTextAlignment="Center" />
                    <Label Text="La vérification du code est terminée côté frontend."
                           FontSize="11" TextColor="#788397" LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Retour à la connexion" Command="{Binding OpenSignInCommand}"
                            BackgroundColor="#315CEB" TextColor="White" FontSize="12"
                            FontAttributes="Bold" CornerRadius="11" HeightRequest="48" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
