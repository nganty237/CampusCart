<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CampusCart.Controls"
             xmlns:vm="clr-namespace:CampusCart.ViewModels"
             xmlns:models="clr-namespace:CampusCart.Models"
             xmlns:icons="clr-namespace:IconFont.Maui.MaterialDesignIcons;assembly=IconFont.Maui.MaterialDesignIcons"
             x:Class="CampusCart.Pages.MessagesPage"
             x:Name="MessagesRoot"
             x:DataType="vm:MessagesViewModel"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             BackgroundColor="#F7F8FC">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" MaximumWidthRequest="480" HorizontalOptions="Center"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,24,16,22" Spacing="17">
                <Grid ColumnDefinitions="*,48" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Messages" FontSize="23" FontAttributes="Bold" TextColor="#171B24" />
                        <Label Text="Les échanges de ton campus." FontSize="12" TextColor="#818897" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" HeightRequest="44" WidthRequest="44" BackgroundColor="#DCE6FF"
                            StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <Label Text="{Binding UserInitials}" FontSize="15" FontAttributes="Bold" TextColor="#315CEB"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border BackgroundColor="White" Stroke="#E4E7ED" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="13,2">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                        <controls:AppIcon Glyph="{x:Static icons:MaterialDesignIconsOutlinedRegular.Search}"
                                          IconSize="18" IconColor="#818897" />
                        <Entry Grid.Column="1" Placeholder="Rechercher une conversation..."
                               Text="{Binding SearchText}" FontSize="13" TextColor="#20232B"
                               PlaceholderColor="#9299A7" ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Conversations}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Conversation">
                            <Border BackgroundColor="White" Stroke="#E4E7ED" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 15" Padding="13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference MessagesRoot}, Path=BindingContext.OpenConversationCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                        <Border HeightRequest="44" WidthRequest="44" BackgroundColor="{Binding AvatarColor}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                            <Label Text="{Binding ContactInitials}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="#315CEB" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding ContactName}" FontSize="13" FontAttributes="Bold" TextColor="#20232B" />
                                            <Label Text="{Binding ServiceTitle}" FontSize="11" TextColor="#818897"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding TimeLabel}" FontSize="10" TextColor="#818897"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Preview}" FontSize="11" TextColor="#555E6D"
                                               LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                                        <Border Grid.Column="1" IsVisible="{Binding HasUnread}" BackgroundColor="#315CEB"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="7,3"
                                                MinimumWidthRequest="24" HorizontalOptions="End">
                                            <Label Text="{Binding UnreadCount}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="White" HorizontalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomNavigationBar Grid.Row="1" SelectedTab="messages" />
    </Grid>
</ContentPage>
