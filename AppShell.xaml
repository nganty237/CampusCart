<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusCart.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CampusCart.Pages"
    FlyoutBehavior="Disabled"
    Title="CampusCart">
    <ShellContent Title="Bienvenue" ContentTemplate="{DataTemplate pages:LandingPage}" Route="landing" />
    <ShellContent Title="Connexion" ContentTemplate="{DataTemplate pages:ConnexionPage}" Route="login" />
    <ShellContent Title="Accueil" ContentTemplate="{DataTemplate pages:MainPage}" Route="home" />
    <ShellContent Title="Demandes" ContentTemplate="{DataTemplate pages:RequestsPage}" Route="requests" />
    <ShellContent Title="Messages" ContentTemplate="{DataTemplate pages:MessagesPage}" Route="messages" />
    <ShellContent Title="Profil" ContentTemplate="{DataTemplate pages:ProfilePage}" Route="profile" />
    <ShellContent Title="Mes offres" ContentTemplate="{DataTemplate pages:MyOffersPage}" Route="myoffers" />
</Shell>
